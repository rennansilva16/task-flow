@using MudBlazor.Utilities
@inherits LayoutComponentBase

<MudThemeProvider />

<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudDrawer Style="border-right: 1px solid #c1bcdb;" @bind-open="_drawerOpen" variant="DrawerVariant.Mini"
               Elevation="1" Class="d-flex flex-column bg-secondary">

        <NavMenu />
        <MudSpacer />

        @* Quero colocar Um MudIconButton no lado direito do botao para fica colado no final *@
        <div class="d-flex justify-content-end p-2">
            <MudIconButton Class="text-white" Icon="@Icons.Material.Filled.Menu" OnClick="ToggleDrawer">

            </MudIconButton>
        </div>

    </MudDrawer>
    <!-- BOTÃO FLUTUANTE -->
    <MudMainContent>
        <MudContainer>
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code
{
    private bool _drawerOpen = true;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}