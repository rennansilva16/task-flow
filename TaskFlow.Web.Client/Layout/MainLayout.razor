@using MudBlazor.Utilities
@inherits LayoutComponentBase

<MudThemeProvider />

<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout Style="background-color: #0F172A; height: 100vh;">
    <MudDrawer Style="background-color: #111827; border-right: 1px solid #c1bcdb;" @bind-open="_drawerOpen" variant="DrawerVariant.Mini" Elevation="1" Class="d-flex flex-column">
        
        <NavMenu />
        <MudSpacer />
        
        @* Quero colocar Um MudIconButton no lado direito do botao para fica colado no final *@
        <div class="d-flex justify-content-end p-2">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Style="@($"color: {Colors.LightGreen.Lighten5}")" OnClick="ToggleDrawer">

            </MudIconButton>
        </div>
        
    </MudDrawer>
     <!-- BOTÃO FLUTUANTE -->
    <MudMainContent >
        <MudContainer>
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code
{
    private bool _drawerOpen = true;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}