@inject ISnackbar Snackbar
@inject TarefaService TarefaService
@inject IDialogService DialogService
@inject IJSRuntime JsRuntime
@page "/Home"
@attribute [Authorize]

<div class="d-flex flex-column text-white" style="height: 100vh;">
	<MudDropContainer T="TaskResponse" Class="pa-4" Items="tasks"
					  ItemsSelector="@((item, col) => item.Status.ToString() == col)" ItemPicked="OnItemPicked"
					  ItemDropped="TaskUpdated">

		<ChildContent>
			@* <MudGrid> *@
			<MudPaper Class="d-flex gap-4 overflow-auto" Style="height: 100%;">

			
				@foreach (var col in columns)
				{
					@* <MudItem xs="12" sm="6" md="3"> *@
					<MudPaper Elevation="1" Class="d-flex flex-column h-100 p-4">
						<div class="d-flex align-center">
							<MudIcon Icon="@GetColumnIcon(col)"
									 Style="@($"color: {GetElementColor(Enum.Parse<Status>(col))};")" Class="mr-2"
									 Size="Size.Small" />

							<div class="d-flex align-center mr-2 justify-center">
								<MudText Typo=" Typo.h6">@col</MudText>
								<MudText Typo="Typo.subtitle2" Class="ml-1 text-white"
										 Style="background-color: #443b7e; border-radius: 12px; padding: 2px 8px;">
									@tasks!.Count(t => t.Status.ToString() == col)
								</MudText>
							</div>
							<MudToolBar Class="flex-grow-1 justify-end">
								<MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Primary" Size="Size.Small">
									<MudMenuItem OnClick="@(() => OpenAddTaskDialog())">
										<MudIcon Icon="@Icons.Material.Filled.Add"
												 Style="@($"color: {GetElementColor(Enum.Parse<Status>(col))};")" Class="mr-2" />
										Adicionar tarefa
									</MudMenuItem>
								</MudMenu>
							</MudToolBar>
						</div>

						<MudDropZone T="TaskResponse" Identifier="@col" Style="min-height: 50px;"
									 Class="d-flex flex-column flex-grow-1 border-radius-4 text-white rounded">
							<!-- Header da coluna -->

							<MudPaper Class="pa-3 mb-2" Style="background-color: #e0e0e0;">

								<MudText Typo="Typo.h6" Class="mb-2">@col</MudText>

							</MudPaper>

						</MudDropZone>
						<MudButton StartIcon="@Icons.Material.Filled.Add" Style="border-radius: 12px; padding: 2px 8px;"
								   Variant="Variant.Text" Class="bg-secondary mt-4 text-white"
								   OnClick="@(() => OpenAddTaskDialog())">
							Adicionar tarefa
						</MudButton>
					</MudPaper>
					@* </MudItem> *@

					
				}
			</MudPaper>
			@* </MudGrid> *@

		</ChildContent>

		<ItemRenderer>
			<MudPaper @onclick="() => OpenTaskDetails(context)" Class="pa-3" Style=@($"border-left: 4px solid {GetElementColor(context.Status)};margin: 4px 0; cursor: pointer;")>
				<div class="d-flex align-center justify-space-between">
					<MudText Typo="Typo.subtitle1">@context.Titulo</MudText>

					<MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Primary" Size="Size.Small">
						<MudMenu Label="Alterar status">

							@foreach (var status in Enum.GetValues<Status>())
							{
								if (status == context.Status)
									continue;

								<MudMenuItem Label="@status.ToString()"
											 OnClick="@(() => UpdateTaskStatus(context, status))" />
							}
						</MudMenu>
						<MudDivider />
						<MudMenuItem OnClick="@(() => OpenEditTaskDialog(context))">
							<MudIcon Icon="@Icons.Material.Filled.Edit"
									 Style="@($"color: {GetElementColor(context.Status)};")" Class="mr-2" />
							Editar
						</MudMenuItem>
						<MudMenuItem OnClick="@(() => OpenDeleteTaskDialog(context))">
							<MudIcon Icon="@Icons.Material.Filled.Delete"
									 Style="@($"color: {GetElementColor(context.Status)};")" Class="mr-2" />
							Excluir
						</MudMenuItem>
					</MudMenu>
				</div>
				@if (context.Descricao != null)
				{
					<div>
						<MudText Typo="Typo.body2" Class="mb-1">
							@context.Descricao
						</MudText>
					</div>
				}
				@if (context.DataPrazo != null)
				{
					<div>
						<MudIcon Icon="@Icons.Material.Filled.CalendarToday"
								 Style="@($"color: {GetElementColor(context.Status)};")" Class="mr-1" Size="Size.Small" />
						<MudText Class="p-1" Typo="Typo.caption" Style="@($"color: {GetElementColor(context.Status)};")">
							@context.DataPrazo?.ToString("dd/MM/yyyy")
						</MudText>

					</div>

				}

				
			</MudPaper>
		</ItemRenderer>

	</MudDropContainer>
</div>

@code {
	private List<TaskResponse>? tasks = new();
	private List<string> columns = Enum.GetValues<Status>().Select(s => s.ToString()).ToList();
	string GetColumnIcon(string column) => column switch
	{

		nameof(Status.Pendente) => Icons.Material.Filled.Schedule,
		nameof(Status.Fazendo) => Icons.Material.Filled.Build,
		nameof(Status.Finalizada) => Icons.Material.Filled.CheckCircle,
		nameof(Status.Cancelada) => Icons.Material.Filled.Cancel,
		_ => Icons.Material.Filled.HelpOutline
	};
	string GetElementColor(Status status) => status switch
	{
		Status.Pendente => "#6c757d", // Cinza
		Status.Fazendo => "#007bff", // Azul
		Status.Finalizada => "#28a745", // Verde
		Status.Cancelada => "#dc3545", // Vermelho
		_ => "#6c757d" // Padrão para outros casos
	};

	protected override async Task OnInitializedAsync()
	{
		tasks = await TarefaService.GetTarefasAsync();
	}

	private async Task TaskUpdated(MudItemDropInfo<TaskResponse> info)
	{
		if (info.Item == null) throw new Exception("Item nulo recebido no evento de drop.");
		var novoStatus = Enum.Parse<Status>(info.DropzoneIdentifier);
		if (info.Item.Status == novoStatus) return; // Evita chamadas desnecessárias à API
		var tarefaAtualizada = await TarefaService.UpdateTaskStatusAsync(info.Item.Id, novoStatus);
		info.Item.Status = tarefaAtualizada.Status; // Atualiza o status localmente para refletir a mudança
		StateHasChanged(); // Força a atualização da UI para refletir a mudança
		await JsRuntime.InvokeVoidAsync("stopAutoScroll"); // Para o auto scroll após a tarefa ser solta na nova coluna
	}

	private async Task UpdateTaskStatus(TaskResponse task, Status novoStatus)
	{
		if (task.Status == novoStatus) return; // Evita chamadas desnecessárias à API
		var tarefaAtualizada = await TarefaService.UpdateTaskStatusAsync(task.Id, novoStatus);
		task.Status = tarefaAtualizada.Status; // Atualiza o status localmente para refletir a mudança
		StateHasChanged(); // Força a atualização da UI para refletir a mudança
	}

	private async Task OnItemPicked(MudDragAndDropItemTransaction<TaskResponse> transaction)
	{
		Console.WriteLine($"Tarefa: {transaction.Item?.Titulo}");
		await JsRuntime.InvokeVoidAsync("startAutoScroll");
	}

	private async Task OpenTaskDetails(TaskResponse task)
	{
		var parameters = new DialogParameters
		{
			[nameof(VisualizarTaskDialog.Task)] = task
		};
		var options = new DialogOptions { CloseOnEscapeKey = true };

		

		var dialog = await DialogService.ShowAsync<VisualizarTaskDialog>(null, parameters, options);


		var result = await dialog.Result;

		// Caso 1: Excluiu a tarefa
		if (result!.Data is RemoveTaskResponse taskRemoveResponse && taskRemoveResponse.Excluido)
		{
			tasks!.Remove(tasks.First(t => t.Id == taskRemoveResponse.Id));
		}
		// Caso 2: Editou a tarefa - Atualiza a tarefa na lista local para refletir as mudanças feitas no diálogo de edição
		else if (result.Data is UpdateTaskResponse response)
		{
			var tarefa = tasks!.First(t => t.Id == response.Id);

			tarefa.Titulo = response.Title;
			tarefa.Descricao = response.Description;
			tarefa.DataPrazo = response.DueDate;
			tarefa.Status = response.Status;
		}
		StateHasChanged(); // Força a atualização da UI para refletir as mudanças
	}

	private async Task OpenAddTaskDialog()
	{
		var options = new DialogOptions { CloseOnEscapeKey = true };
		var dialog = await DialogService.ShowAsync<AddTaskDialog>(null, options);
		var result = await dialog.Result;

		if (!result!.Canceled && result.Data is CreateTaskRequest novaTarefa)
		{
			var tarefaCriada = await TarefaService.CreateTarefaAsync(novaTarefa);
			tasks!.Add(tarefaCriada!);
			StateHasChanged();
		}
	}

	private async Task OpenEditTaskDialog(TaskResponse task)
	{
		var parameters = new DialogParameters
		{
			[nameof(UpdateTaskDialog.Task)] = task
		};
		var options = new DialogOptions { CloseOnEscapeKey = true };
		var dialog = await DialogService.ShowAsync<UpdateTaskDialog>(null, parameters, options);
		var result = await dialog.Result;

		if (!result!.Canceled && result.Data is UpdateTaskRequest requestTaskAtualizada)
		{
			var taskAtualizada = await TarefaService.UpdateTarefaAsync(requestTaskAtualizada.Id, requestTaskAtualizada);
			if (taskAtualizada == null)
			{
				Snackbar.Add("Erro ao atualizar a tarefa.", Severity.Error);
				return;
			}
			var tarefa = tasks!.FirstOrDefault(t => t.Id == taskAtualizada.Id);

			if (tarefa != null)
			{
				tarefa.Titulo = requestTaskAtualizada.Titulo;
				tarefa.Descricao = requestTaskAtualizada.Descricao;
				tarefa.DataPrazo = requestTaskAtualizada.DataPrazo;
				tarefa.Status = requestTaskAtualizada.Status;
				Snackbar.Add("Tarefa atualizada com sucesso.", Severity.Success);
			}
			StateHasChanged();
		}
	}

	private async Task OpenDeleteTaskDialog(TaskResponse task)
	{
		var parameters = new DialogParameters
		{
			[nameof(DeleteTaskDialog.Task)] = task
		};
		var options = new DialogOptions { CloseOnEscapeKey = true };
		var dialog = await DialogService.ShowAsync<DeleteTaskDialog>(null, parameters, options);
		var result = await dialog.Result;

		if (!result!.Canceled && result.Data is RemoveTaskResponse removeTaskDto && removeTaskDto.Excluido)
		{
			tasks!.Remove(tasks.First(t => t.Id == removeTaskDto.Id));
			StateHasChanged();
		}
	}
}