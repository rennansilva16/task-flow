@inject ISnackbar Snackbar
@inject ITarefaServiceAPI TaskService
<MudPaper Class="d-flex flex-column" Width="400px">
    <MudDialog>
        <DialogContent>
            <MudPaper Elevation="0" Class="d-flex flex-column gap-4">
                <MudStack Justify="Justify.Center" Row="true" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Medium" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Editar Tarefa</MudText>
                </MudStack>
                <MudGrid>
                    <MudItem xs="12">
                        <MudTextField Variant="Variant.Outlined" Label="Título" @bind-Value="Task.Titulo"
                                      FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField Variant="Variant.Outlined" Label="Descrição" @bind-Value="Task.Descricao"
                                      FullWidth="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudDatePicker Variant="Variant.Outlined" Label="Data de Prazo" @bind-Date="datePrazoTemp" />
                    </MudItem>
                </MudGrid>
            </MudPaper>

        </DialogContent>
        <DialogActions>
            <MudStack Justify="Justify.FlexEnd" Row="true" Spacing="2">
                <MudButton Color="Color.Primary" OnClick="Salvar">Salvar</MudButton>
                <MudButton Color="Color.Secondary" OnClick="Fechar">Fechar</MudButton>
            </MudStack>
        </DialogActions>
    </MudDialog>
</MudPaper>


@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter]
    public TaskResponse Task { get; set; } = default!;
    private DateTime? datePrazoTemp;
    protected override void OnInitialized()
    {
        datePrazoTemp = DateTime.TryParse(Task.DataPrazo?.ToString("dd/MM/yyyy"), out var parsedDate) ? parsedDate :
(DateTime?)null;
    }

    private void Fechar()
    {
        MudDialog.Close(DialogResult.Cancel());
    }

    private async Task Salvar()
    {
        var tarefaAtualizada = new UpdateTaskRequest
        {
            Id = Task.Id,
            Titulo = Task.Titulo,
            Descricao = Task.Descricao,
            DataPrazo = DateOnly.TryParse(datePrazoTemp?.ToString("dd/MM/yyyy"), out var parsedDate) ? parsedDate : (DateOnly?)null,
            Status = Task.Status
        };
        UpdateTaskResponse? tarefaSalva = await TaskService.UpdateTarefaAsync(Task.Id, tarefaAtualizada);

        if (tarefaSalva == null)
        {
            Snackbar.Add("Erro ao atualizar a tarefa. Por favor, tente novamente.", Severity.Error);
            return;
        }
        MudDialog.Close(DialogResult.Ok(tarefaSalva));
    }
}