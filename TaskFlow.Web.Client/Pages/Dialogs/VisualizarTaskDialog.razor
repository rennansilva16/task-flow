@inject ISnackbar Snackbar
@inject TarefaService TarefaService
@inject IDialogService DialogService


<MudDialog>
    <DialogContent>
        <MudPaper Elevation="0" Class="d-flex flex-column gap-4">
            <MudStack AlignItems="AlignItems.Center"  Justify="Justify.Center" Row="true" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Medium" Color="Color.Primary" />
                <MudText Typo="Typo.h6">Detalhes da Tarefa</MudText>
            </MudStack>
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField Variant="Variant.Outlined" Typo="Typo.h6" Label="Título" Value="@Task.Titulo" ReadOnly="true" />
                </MudItem>
                @if (!string.IsNullOrEmpty(Task.Descricao))
                {
                    <MudItem xs="12">
                        <MudTextField Variant="Variant.Outlined" Typo="Typo.body1" Label="Descrição" Value="@Task.Descricao" ReadOnly="true" />
                    </MudItem>
                }
                <MudItem xs="12">
                    <MudStack Row="true" Spacing="2">
                        @if (Task.DataPrazo != null)
                        {
                            <MudTextField Variant="Variant.Outlined" Typo="Typo.body1" Label="Prazo" Value="@Task.DataPrazo?.ToString("dd/MM/yyyy")" ReadOnly="true" />
                        }
                        <MudTextField Variant="Variant.Outlined" Typo="Typo.body1" Label="Status" Value="@Task.StatusCol" ReadOnly="true"/>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="OpenEditTaskDialog">Editar</MudButton>
        <MudButton Color="Color.Primary" OnClick="OpenDeleteTaskDialog">Excluir</MudButton>
        <MudButton Color="Color.Secondary" OnClick="Fechar">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter]
    public TaskResponse Task { get; set; } = default!;
    private bool Updated { get; set; } = false;

    private void Fechar()
    {
        MudDialog.Close(Updated ? DialogResult.Ok(Task) : DialogResult.Cancel());
    }

    private async Task OpenEditTaskDialog()
    {
        var parameters = new DialogParameters
        {
            [nameof(UpdateTaskDialog.Task)] = Task
        };
        var options = new DialogOptions { CloseOnEscapeKey = true };

        var dialog = await DialogService.ShowAsync<UpdateTaskDialog>("Editar Tarefa", parameters, options);

        var result = await dialog.Result;

        if (result!.Data is UpdateTaskRequest requestTaskAtualizada)
        {
            Task.Titulo = requestTaskAtualizada.Titulo;
            Task.Descricao = requestTaskAtualizada.Descricao;
            Task.DataPrazo = requestTaskAtualizada.DataPrazo;
            Task.Status = requestTaskAtualizada.Status;
            Updated = true;
            StateHasChanged(); // Força a atualização da UI para refletir as mudanças
        }
    }
    private async Task OpenDeleteTaskDialog()
    {
        var parameters = new DialogParameters
        {
            [nameof(DeleteTaskDialog.Task)] = Task
        };
        var options = new DialogOptions { CloseOnEscapeKey = true };

        var dialog = await DialogService.ShowAsync<DeleteTaskDialog>(null, parameters, options);

        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is RemoveTaskResponse removeTaskDto && removeTaskDto.Excluido)
        {
            MudDialog.Close(DialogResult.Ok(removeTaskDto));
        }
    }
}