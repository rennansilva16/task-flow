@inject ISnackbar Snackbar
@inject TarefaService TarefaService
@inject IDialogService DialogService


<MudDialog>
    <TitleContent>
        Visualizar Tarefa
    </TitleContent>
    <DialogContent>

        <MudText Typo="Typo.h6">@Task.Titulo</MudText>

        <MudText Class="mt-2">@Task.Descricao</MudText>

        <MudText Class="mt-2">
            Prazo: @Task.DataPrazo?.ToString("dd/MM/yyyy")
        </MudText>

        <MudText Class="mt-2">
            Status: @Task.Status
        </MudText>

    </DialogContent>
    <DialogActions>
            <MudButton Color="Color.Primary" OnClick="OpenEditTaskDialog">Editar</MudButton>
        <MudButton Color="Color.Primary" OnClick="Excluir">Excluir</MudButton>
        <MudButton Color="Color.Secondary" OnClick="Fechar">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter]
    public TaskResponse Task { get; set; } = default!;
    private bool Updated { get; set; } = false;

    private void Fechar()
    {
        MudDialog.Close(Updated ? DialogResult.Ok(Task) : DialogResult.Cancel());
    } 

    private async Task Excluir()
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Confirmação",
            "Tem certeza que deseja excluir esta tarefa?",
            yesText: "Sim",
            noText: "Não");

        if (confirm == true)
        {
            var request = new TaskRemoveRequest
            {
                Id = Task.Id
            };

            MudDialog.Close(DialogResult.Ok(request));
        }
    }

    private async Task OpenEditTaskDialog()
    {
        var parameters = new DialogParameters
        {
            [nameof(UpdateTaskDialog.Task)] = Task
        };
        var options = new DialogOptions { CloseOnEscapeKey = true };

        var dialog = await DialogService.ShowAsync<UpdateTaskDialog>("Editar Tarefa", parameters, options);

        var result = await dialog.Result;

        if (result!.Data is UpdateTaskRequest requestTaskAtualizada)
        {
            Task.Titulo = requestTaskAtualizada.Titulo;
            Task.Descricao = requestTaskAtualizada.Descricao;
            Task.DataPrazo = requestTaskAtualizada.DataPrazo;
            Task.Status = requestTaskAtualizada.Status;
            Updated = true;
            StateHasChanged(); // Força a atualização da UI para refletir as mudanças
        }
    }
}