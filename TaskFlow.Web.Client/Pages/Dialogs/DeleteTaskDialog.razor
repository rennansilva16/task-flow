@inject ITarefaServiceAPI TaskService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudPaper Elevation="0" Class="d-flex flex-column gap-4">
            <MudStack Justify="Justify.Center" Row="true" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Medium" Color="Color.Error" />
                <MudText Typo="Typo.h6">Excluir Tarefa</MudText>
            </MudStack>
            <MudText Typo="Typo.body1">Tem certeza de que deseja excluir esta tarefa?</MudText>
        </MudPaper>

    </DialogContent>
    <DialogActions>
        <MudStack Justify="Justify.FlexEnd" Row="true" Spacing="2">
            <MudButton Color="Color.Error" OnClick="Excluir">Excluir</MudButton>
            <MudButton Color="Color.Secondary" OnClick="Fechar">Cancelar</MudButton>
        </MudStack>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter]
    public TaskResponse Task { get; set; } = default!;

    private void Fechar()
    {
        MudDialog.Close(DialogResult.Cancel());
    }

    private async Task Excluir()
    {
        // Lógica para excluir a tarefa usando o ID
        RemoveTaskResponse? response = await TaskService.DeleteTarefaAsync(Task.Id);
        // Exemplo: await TaskService.DeleteTask(Task.Id);
        if (response == null || !response.Excluido)
        {
            // Mensagem de erro ao excluir
            Snackbar.Add("Erro ao excluir a tarefa.", Severity.Error);
            return;
        }
        MudDialog.Close(DialogResult.Ok(response)); // Retorna true para indicar que a tarefa foi excluída
    }
}